rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedPhone() {
      return signedIn() && request.auth.token.phone_number != null;
    }

    function validMoroccanCity(cityId) {
      return cityId is string && cityId.matches('^[0-9]{7,10}$');
    }

    function currentPeriodKey() {
      let month = request.time.month();
      return string(request.time.year())
        + '-'
        + (month < 10 ? '0' : '')
        + string(month);
    }

    function invitationPath(residenceId, invitationId) {
      return /databases/$(database)/documents/residences/$(residenceId)/invitations/$(invitationId);
    }

    function residencePath(residenceId) {
      return /databases/$(database)/documents/residences/$(residenceId);
    }

    function residenceCodePath(code) {
      return /databases/$(database)/documents/residenceCodes/$(code);
    }

    function memberPath(residenceId, memberId) {
      return /databases/$(database)/documents/residences/$(residenceId)/members/$(memberId);
    }

    function privateSettingsPath(residenceId) {
      return /databases/$(database)/documents/residences/$(residenceId)/settings/private;
    }

    function isResidenceMember(residenceId) {
      return signedIn()
        && get(
          memberPath(residenceId, request.auth.uid)
        ).data.status == 'active';
    }

    function canManageResidence(residenceId) {
      let membership = get(
        memberPath(residenceId, request.auth.uid)
      ).data;
      return signedIn()
        && membership.status == 'active'
        && (
          membership.role in ['president', 'owner']
          || membership.hasPresidentPermissions == true
        );
    }

    function isOwnResidenceApartment(residenceId, apartmentId) {
      return isResidenceMember(residenceId)
        && get(
          memberPath(residenceId, request.auth.uid)
        ).data.apartmentId == apartmentId;
    }

    function isPresident(residenceId) {
      let membership = get(
        memberPath(residenceId, request.auth.uid)
      ).data;
      let residence = get(residencePath(residenceId)).data;
      return signedIn()
        && membership.status == 'active'
        && membership.role in ['president', 'owner']
        && (
          residence.presidentId == request.auth.uid
          || residence.presidentId == null
        );
    }

    function isInvitationMembership(residenceId, memberId) {
      let invitation = get(
        invitationPath(
          residenceId,
          request.resource.data.sourceInvitationId
        )
      ).data;
      let acceptedInvitation = getAfter(
        invitationPath(
          residenceId,
          request.resource.data.sourceInvitationId
        )
      ).data;
      return verifiedPhone()
        && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly([
          'userId',
          'firstName',
          'lastName',
          'phoneNumber',
          'apartmentId',
          'role',
          'hasPresidentPermissions',
          'status',
          'sourceInvitationId',
          'joinedAt'
        ])
        && request.resource.data.userId == memberId
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.phoneNumber
          == request.auth.token.phone_number
        && request.resource.data.apartmentId is string
        && request.resource.data.role in [
          'resident',
          'deputy',
          'treasurer'
        ]
        && request.resource.data.hasPresidentPermissions == false
        && request.resource.data.status == 'active'
        && request.resource.data.sourceInvitationId is string
        && request.resource.data.joinedAt == request.time
        && acceptedInvitation.status == 'accepted'
        && acceptedInvitation.acceptedBy == request.auth.uid
        && invitation.phoneNumber == request.auth.token.phone_number
        && request.resource.data.apartmentId == invitation.apartmentId
        && request.resource.data.role == invitation.role;
    }

    function isResidenceCreatorMembership(residenceId, memberId) {
      return verifiedPhone()
        && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly([
          'userId',
          'firstName',
          'lastName',
          'phoneNumber',
          'apartmentId',
          'role',
          'hasPresidentPermissions',
          'status',
          'source',
          'joinedAt'
        ])
        && request.resource.data.userId == memberId
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.phoneNumber
          == request.auth.token.phone_number
        && request.resource.data.apartmentId == ''
        && request.resource.data.role == 'president'
        && request.resource.data.hasPresidentPermissions == false
        && request.resource.data.status == 'active'
        && request.resource.data.source == 'residence-creation'
        && request.resource.data.joinedAt == request.time
        && !exists(residencePath(residenceId))
        && getAfter(residencePath(residenceId)).data.name is string;
    }

    function isJoinCodeMembership(residenceId, memberId) {
      return verifiedPhone()
        && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly([
          'userId',
          'firstName',
          'lastName',
          'phoneNumber',
          'apartmentId',
          'role',
          'hasPresidentPermissions',
          'status',
          'source',
          'residenceCode',
          'joinedAt'
        ])
        && request.resource.data.userId == memberId
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.phoneNumber
          == request.auth.token.phone_number
        && request.resource.data.apartmentId == ''
        && request.resource.data.role == 'resident'
        && request.resource.data.hasPresidentPermissions == false
        && request.resource.data.status == 'active'
        && request.resource.data.source == 'join-code'
        && request.resource.data.residenceCode is string
        && request.resource.data.joinedAt == request.time
        && get(
          residenceCodePath(request.resource.data.residenceCode)
        ).data.residenceId == residenceId
        && get(residencePath(residenceId)).data.joinRequestsEnabled == true;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;

      allow create: if verifiedPhone()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'firstName',
          'lastName',
          'phoneNumber',
          'activeResidenceId',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.phoneNumber == request.auth.token.phone_number
        && request.resource.data.activeResidenceId is string
        && getAfter(
          memberPath(request.resource.data.activeResidenceId, userId)
        ).data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if verifiedPhone()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName',
          'lastName',
          'activeResidenceId',
          'updatedAt'
        ])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.phoneNumber == request.auth.token.phone_number
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['activeResidenceId'])
          || (
            request.resource.data.activeResidenceId is string
            && getAfter(
              memberPath(request.resource.data.activeResidenceId, userId)
            ).data.status == 'active'
          )
        )
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{userId}/pushTokens/{tokenId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'token',
          'platform',
          'residenceIds',
          'updatedAt'
        ])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.platform in ['android', 'iOS', 'web']
        && request.resource.data.residenceIds is list
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read: if signedIn() && request.auth.uid == userId;

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'readAt'
        ])
        && request.resource.data.readAt == request.time;
    }

    match /directoryRecommendations/{recommendationId} {
      allow read: if signedIn();

      allow create: if isResidenceMember(
          request.resource.data.residenceId
        )
        && request.resource.data.keys().hasOnly([
          'entryId',
          'residenceId',
          'userId',
          'authorName',
          'residenceName',
          'comment',
          'createdAt'
        ])
        && request.resource.data.entryId is string
        && request.resource.data.entryId.size() > 0
        && request.resource.data.residenceId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.residenceName is string
        && request.resource.data.residenceName.size() > 0
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.entryId == resource.data.entryId
        && request.resource.data.residenceId == resource.data.residenceId
        && request.resource.data.userId == resource.data.userId
        && isResidenceMember(resource.data.residenceId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authorName',
          'residenceName',
          'comment',
          'createdAt'
        ])
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.residenceName is string
        && request.resource.data.residenceName.size() > 0
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.createdAt == request.time;

      allow delete: if false;
    }

    match /residences/{residenceId} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if verifiedPhone()
        && request.resource.data.keys().hasOnly([
          'name',
          'address',
          'city',
          'establishmentYear',
          'hasImage',
          'presidentId',
          'joinRequestsEnabled',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && validMoroccanCity(request.resource.data.city)
        && request.resource.data.establishmentYear is int
        && request.resource.data.establishmentYear >= 1800
        && request.resource.data.hasImage == false
        && request.resource.data.presidentId == request.auth.uid
        && request.resource.data.joinRequestsEnabled == true
        && request.resource.data.createdAt == request.time;

      allow update: if (
          canManageResidence(residenceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'address',
            'city',
            'establishmentYear',
            'hasImage',
            'joinRequestsEnabled',
            'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.address is string
          && request.resource.data.address.size() > 0
          && validMoroccanCity(request.resource.data.city)
          && request.resource.data.establishmentYear is int
          && request.resource.data.establishmentYear >= 1800
          && request.resource.data.hasImage is bool
          && request.resource.data.joinRequestsEnabled is bool
          && request.resource.data.updatedAt == request.time
        )
        || (
          isPresident(residenceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'presidentId',
            'updatedAt'
          ])
          && request.resource.data.presidentId is string
          && request.resource.data.presidentId != request.auth.uid
          && getAfter(
            memberPath(residenceId, request.resource.data.presidentId)
          ).data.role == 'president'
          && getAfter(
            memberPath(residenceId, request.auth.uid)
          ).data.role == 'resident'
          && request.resource.data.updatedAt == request.time
        );

      match /settings/private {
        allow read: if isResidenceMember(residenceId);

        allow create: if verifiedPhone()
          && !exists(residencePath(residenceId))
          && getAfter(
            memberPath(residenceId, request.auth.uid)
          ).data.role == 'president'
          && request.resource.data.keys().hasOnly([
            'createdBy',
            'joinCode',
            'managementOrganization',
            'managementPhone',
            'bankName',
            'bankAccount',
            'defaultSubscriptionAmount',
            'updatedAt'
          ])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.joinCode is string
          && request.resource.data.joinCode.matches('^[0-9]{8}$')
          && request.resource.data.managementOrganization is string
          && request.resource.data.managementOrganization.size() > 0
          && request.resource.data.managementPhone
            == request.auth.token.phone_number
          && request.resource.data.bankName is string
          && request.resource.data.bankAccount is string
          && request.resource.data.defaultSubscriptionAmount is int
          && request.resource.data.defaultSubscriptionAmount == 150
          && request.resource.data.updatedAt == request.time;

        allow update: if canManageResidence(residenceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'managementOrganization',
            'managementPhone',
            'bankName',
            'bankAccount',
            'defaultSubscriptionAmount',
            'updatedAt'
          ])
          && request.resource.data.managementOrganization is string
          && request.resource.data.managementPhone is string
          && request.resource.data.bankName is string
          && request.resource.data.bankAccount is string
          && request.resource.data.defaultSubscriptionAmount is int
          && request.resource.data.defaultSubscriptionAmount >= 0
          && request.resource.data.updatedAt == request.time;
      }

      match /invitations/{invitationId} {
        allow read: if canManageResidence(residenceId);

        allow create: if canManageResidence(residenceId)
          && request.resource.data.keys().hasOnly([
            'suggestedFirstName',
            'suggestedLastName',
            'phoneNumber',
            'apartmentId',
            'role',
            'hasPresidentPermissions',
            'status',
            'createdAt'
          ])
          && request.resource.data.suggestedFirstName is string
          && request.resource.data.suggestedFirstName.size() > 0
          && request.resource.data.suggestedLastName is string
          && request.resource.data.suggestedLastName.size() > 0
          && request.resource.data.phoneNumber is string
          && request.resource.data.phoneNumber.matches(
            '^[+][1-9][0-9]{7,14}$'
          )
          && invitationId == request.resource.data.phoneNumber
          && request.resource.data.apartmentId is string
          && request.resource.data.role == 'resident'
          && request.resource.data.hasPresidentPermissions == false
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;

        allow update: if verifiedPhone()
          && resource.data.phoneNumber == request.auth.token.phone_number
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'acceptedBy',
            'acceptedAt'
          ])
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedBy == request.auth.uid
          && request.resource.data.acceptedAt == request.time;
      }

      match /members/{memberId} {
        allow read: if isResidenceMember(residenceId);
        allow create: if isResidenceCreatorMembership(residenceId, memberId)
          || isInvitationMembership(residenceId, memberId)
          || isJoinCodeMembership(residenceId, memberId);

        allow update: if (
            canManageResidence(residenceId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'apartmentId',
              'status',
              'updatedAt'
            ])
            && request.resource.data.apartmentId is string
            && request.resource.data.status in ['active', 'removed']
            && (
              request.resource.data.status != 'removed'
              || !(resource.data.role in ['president', 'owner'])
            )
            && request.resource.data.updatedAt == request.time
          )
          || (
            canManageResidence(residenceId)
            && !(resource.data.role in ['president', 'owner'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'role',
              'updatedAt'
            ])
            && request.resource.data.role in [
              'deputy',
              'treasurer',
              'resident'
            ]
            && request.resource.data.updatedAt == request.time
          )
          || (
            isPresident(residenceId)
            && memberId != request.auth.uid
            && !(resource.data.role in ['president', 'owner'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'hasPresidentPermissions',
              'updatedAt'
            ])
            && request.resource.data.hasPresidentPermissions is bool
            && request.resource.data.updatedAt == request.time
          )
          || (
            isPresident(residenceId)
            && memberId != request.auth.uid
            && !(resource.data.role in ['president', 'owner'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'role',
              'hasPresidentPermissions',
              'updatedAt'
            ])
            && request.resource.data.role == 'president'
            && request.resource.data.hasPresidentPermissions == false
            && getAfter(residencePath(residenceId)).data.presidentId == memberId
            && request.resource.data.updatedAt == request.time
          )
          || (
            memberId == request.auth.uid
            && isPresident(residenceId)
            && resource.data.role in ['president', 'owner']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'role',
              'hasPresidentPermissions',
              'updatedAt'
            ])
            && request.resource.data.role == 'resident'
            && request.resource.data.hasPresidentPermissions == false
            && getAfter(residencePath(residenceId)).data.presidentId != memberId
            && request.resource.data.updatedAt == request.time
          )
          || (
            memberId == request.auth.uid
            && isResidenceMember(residenceId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'firstName',
              'lastName',
              'updatedAt'
            ])
            && request.resource.data.firstName is string
            && request.resource.data.firstName.size() > 0
            && request.resource.data.lastName is string
            && request.resource.data.lastName.size() > 0
            && request.resource.data.updatedAt == request.time
          )
          || isJoinCodeMembership(residenceId, memberId);
      }

      match /dues/{dueId} {
        allow read: if isResidenceMember(residenceId);

        allow create: if (
            canManageResidence(residenceId)
            || (
              isOwnResidenceApartment(
                residenceId,
                request.resource.data.apartmentId
              )
              && request.resource.data.periodKey <= currentPeriodKey()
              && request.resource.data.amountDue
                == get(
                  privateSettingsPath(residenceId)
                ).data.defaultSubscriptionAmount
              && request.resource.data.amountPaid == 0
            )
          )
          && request.resource.data.keys().hasOnly([
            'apartmentId',
            'apartmentNumber',
            'periodKey',
            'amountDue',
            'amountPaid',
            'status',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.apartmentId is string
          && request.resource.data.apartmentId.size() > 0
          && request.resource.data.apartmentNumber is string
          && request.resource.data.apartmentNumber.size() > 0
          && request.resource.data.periodKey is string
          && request.resource.data.periodKey.matches(
            '^[0-9]{4}-(0[1-9]|1[0-2])$'
          )
          && dueId == request.resource.data.periodKey
            + '_'
            + request.resource.data.apartmentId
          && request.resource.data.amountDue is int
          && request.resource.data.amountDue >= 0
          && request.resource.data.amountPaid is int
          && request.resource.data.amountPaid >= 0
          && request.resource.data.amountPaid
            <= request.resource.data.amountDue
          && (
            (
              request.resource.data.amountPaid == 0
              && request.resource.data.amountDue > 0
              && request.resource.data.status == 'unpaid'
            )
            || (
              request.resource.data.amountPaid > 0
              && request.resource.data.amountPaid
                < request.resource.data.amountDue
              && request.resource.data.status == 'partial'
            )
            || (
              request.resource.data.amountPaid
                == request.resource.data.amountDue
              && request.resource.data.status == 'paid'
            )
          )
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if canManageResidence(residenceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'amountPaid',
            'status',
            'updatedAt'
          ])
          && request.resource.data.amountPaid is int
          && request.resource.data.amountPaid >= resource.data.amountPaid
          && request.resource.data.amountPaid <= resource.data.amountDue
          && (
            (
              request.resource.data.amountPaid == 0
              && request.resource.data.status == 'unpaid'
            )
            || (
              request.resource.data.amountPaid > 0
              && request.resource.data.amountPaid
                < request.resource.data.amountDue
              && request.resource.data.status == 'partial'
            )
            || (
              request.resource.data.amountPaid
                == request.resource.data.amountDue
              && request.resource.data.status == 'paid'
            )
          )
          && request.resource.data.updatedAt == request.time;
      }

      match /duePayments/{paymentId} {
        allow read: if isResidenceMember(residenceId);

        allow create: if canManageResidence(residenceId)
          && request.resource.data.keys().hasOnly([
            'dueId',
            'paymentGroupId',
            'apartmentId',
            'apartmentNumber',
            'amount',
            'paidAt',
            'note',
            'supportingDocument',
            'attachmentStoragePath',
            'attachmentContentType',
            'attachmentSizeBytes',
            'recordedBy',
            'createdAt'
          ])
          && request.resource.data.dueId is string
          && request.resource.data.dueId.size() > 0
          && request.resource.data.paymentGroupId is string
          && request.resource.data.paymentGroupId.size() > 0
          && request.resource.data.apartmentId is string
          && request.resource.data.apartmentId.size() > 0
          && request.resource.data.apartmentNumber is string
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.paidAt is timestamp
          && request.resource.data.paidAt <= request.time
          && request.resource.data.note is string
          && request.resource.data.supportingDocument is string
          && (
            !request.resource.data.keys().hasAny([
              'attachmentStoragePath',
              'attachmentContentType',
              'attachmentSizeBytes'
            ])
            || (
              request.resource.data.attachmentStoragePath is string
              && request.resource.data.attachmentStoragePath
                == 'residences/' + residenceId + '/attachments/dues-'
                  + request.resource.data.paymentGroupId + '/content'
              && request.resource.data.attachmentContentType in [
                'application/pdf',
                'image/jpeg',
                'image/png',
                'image/webp'
              ]
              && request.resource.data.attachmentSizeBytes is int
              && request.resource.data.attachmentSizeBytes > 0
              && request.resource.data.attachmentSizeBytes
                <= 15 * 1024 * 1024
            )
          )
          && request.resource.data.recordedBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
      }

      match /financeTransactions/{transactionId} {
        allow read: if isResidenceMember(residenceId);

        allow create: if canManageResidence(residenceId)
          && request.resource.data.keys().hasOnly([
            'type',
            'amount',
            'date',
            'name',
            'expenseCategory',
            'note',
            'supportingDocument',
            'attachmentStoragePath',
            'attachmentContentType',
            'attachmentSizeBytes',
            'recordedBy',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.date is timestamp
          && request.resource.data.date <= request.time
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && (
            (
              request.resource.data.type == 'income'
              && request.resource.data.expenseCategory == null
            )
            || (
              request.resource.data.type == 'expense'
              && request.resource.data.expenseCategory in [
                'maintenance',
                'utilities',
                'cleaning',
                'security',
                'custom'
              ]
            )
          )
          && request.resource.data.note is string
          && request.resource.data.supportingDocument is string
          && (
            !request.resource.data.keys().hasAny([
              'attachmentStoragePath',
              'attachmentContentType',
              'attachmentSizeBytes'
            ])
            || (
              request.resource.data.attachmentStoragePath is string
              && request.resource.data.attachmentStoragePath
                == 'residences/' + residenceId + '/attachments/finance-'
                  + transactionId + '/content'
              && request.resource.data.attachmentContentType in [
                'application/pdf',
                'image/jpeg',
                'image/png',
                'image/webp'
              ]
              && request.resource.data.attachmentSizeBytes is int
              && request.resource.data.attachmentSizeBytes > 0
              && request.resource.data.attachmentSizeBytes
                <= 15 * 1024 * 1024
            )
          )
          && request.resource.data.recordedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if canManageResidence(residenceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'type',
            'amount',
            'date',
            'name',
            'expenseCategory',
            'note',
            'supportingDocument',
            'attachmentStoragePath',
            'attachmentContentType',
            'attachmentSizeBytes',
            'updatedAt'
          ])
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.date is timestamp
          && request.resource.data.date <= request.time
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && (
            (
              request.resource.data.type == 'income'
              && request.resource.data.expenseCategory == null
            )
            || (
              request.resource.data.type == 'expense'
              && request.resource.data.expenseCategory in [
                'maintenance',
                'utilities',
                'cleaning',
                'security',
                'custom'
              ]
            )
          )
          && request.resource.data.note is string
          && request.resource.data.supportingDocument is string
          && (
            !request.resource.data.keys().hasAny([
              'attachmentStoragePath',
              'attachmentContentType',
              'attachmentSizeBytes'
            ])
            || (
              request.resource.data.attachmentStoragePath is string
              && request.resource.data.attachmentStoragePath
                == 'residences/' + residenceId + '/attachments/finance-'
                  + transactionId + '/content'
              && request.resource.data.attachmentContentType in [
                'application/pdf',
                'image/jpeg',
                'image/png',
                'image/webp'
              ]
              && request.resource.data.attachmentSizeBytes is int
              && request.resource.data.attachmentSizeBytes > 0
              && request.resource.data.attachmentSizeBytes
                <= 15 * 1024 * 1024
            )
          )
          && request.resource.data.updatedAt == request.time;

        allow delete: if canManageResidence(residenceId);
      }

      match /documents/{documentId} {
        allow read: if isResidenceMember(residenceId);

        allow create: if canManageResidence(residenceId)
          && request.resource.data.keys().hasOnly([
            'title',
            'originalFileName',
            'storagePath',
            'contentType',
            'sizeBytes',
            'uploadedBy',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.originalFileName is string
          && request.resource.data.originalFileName.size() > 0
          && request.resource.data.originalFileName.size() <= 255
          && request.resource.data.storagePath
            == 'residences/' + residenceId
              + '/documents/' + documentId + '/content'
          && request.resource.data.contentType in [
            'application/pdf',
            'image/jpeg',
            'image/png',
            'image/webp'
          ]
          && request.resource.data.sizeBytes is int
          && request.resource.data.sizeBytes > 0
          && request.resource.data.sizeBytes <= 15 * 1024 * 1024
          && request.resource.data.uploadedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if canManageResidence(residenceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title',
            'updatedAt'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.updatedAt == request.time;

        allow delete: if canManageResidence(residenceId);
      }

      match /communityPosts/{postId} {
        allow read: if isResidenceMember(residenceId);

        allow create: if isResidenceMember(residenceId)
          && request.resource.data.keys().hasOnly([
            'authorId',
            'authorName',
            'authorUnit',
            'authorRole',
            'title',
            'body',
            'kind',
            'isOfficial',
            'imagePaths',
            'pollOptions',
            'likedBy',
            'savedBy',
            'commentCount',
            'eventDate',
            'eventLocation',
            'archivedAt',
            'archivedBy',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorUnit is string
          && request.resource.data.authorRole
            == get(
              memberPath(residenceId, request.auth.uid)
            ).data.role
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 160
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 5000
          && request.resource.data.kind in [
            'question',
            'complaint',
            'suggestion',
            'alert',
            'general',
            'poll',
            'event'
          ]
          && request.resource.data.isOfficial
            == (
              request.resource.data.authorRole in ['president', 'owner']
            )
          && request.resource.data.imagePaths is list
          && request.resource.data.imagePaths.size() <= 4
          && request.resource.data.pollOptions is list
          && request.resource.data.pollOptions.size() <= 5
          && request.resource.data.likedBy == []
          && request.resource.data.savedBy == []
          && request.resource.data.commentCount == 0
          && (
            request.resource.data.eventDate == null
            || request.resource.data.eventDate is string
          )
          && (
            request.resource.data.eventLocation == null
            || request.resource.data.eventLocation is string
          )
          && request.resource.data.archivedAt == null
          && request.resource.data.archivedBy == null
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isResidenceMember(residenceId)
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'archivedAt',
            'archivedBy',
            'updatedAt'
          ])
          && request.resource.data.archivedAt == request.time
          && request.resource.data.archivedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow update: if isResidenceMember(residenceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likedBy',
            'savedBy',
            'updatedAt'
          ])
          && request.resource.data.likedBy is list
          && request.resource.data.savedBy is list
          && request.resource.data.likedBy.size()
            == request.resource.data.likedBy.toSet().size()
          && request.resource.data.savedBy.size()
            == request.resource.data.savedBy.toSet().size()
          && request.resource.data.likedBy.toSet()
            .difference(resource.data.likedBy.toSet())
            .hasOnly([request.auth.uid])
          && resource.data.likedBy.toSet()
            .difference(request.resource.data.likedBy.toSet())
            .hasOnly([request.auth.uid])
          && request.resource.data.savedBy.toSet()
            .difference(resource.data.savedBy.toSet())
            .hasOnly([request.auth.uid])
          && resource.data.savedBy.toSet()
            .difference(request.resource.data.savedBy.toSet())
            .hasOnly([request.auth.uid])
          && request.resource.data.updatedAt == request.time;

        allow update: if isResidenceMember(residenceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'commentCount',
            'updatedAt'
          ])
          && request.resource.data.commentCount
            == resource.data.commentCount + 1
          && request.resource.data.updatedAt == request.time;

        match /comments/{commentId} {
          allow read: if isResidenceMember(residenceId);
          allow create: if isResidenceMember(residenceId)
            && request.resource.data.keys().hasOnly([
              'authorId',
              'authorName',
              'body',
              'createdAt'
            ])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.authorName is string
            && request.resource.data.authorName.size() > 0
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 1000
            && request.resource.data.createdAt == request.time;
          allow update: if false;
          allow delete: if isResidenceMember(residenceId)
            && (
              resource.data.authorId == request.auth.uid
              || canManageResidence(residenceId)
            );
        }

        match /votes/{userId} {
          allow read: if isResidenceMember(residenceId);
          allow create: if isResidenceMember(residenceId)
            && userId == request.auth.uid
            && !exists(
              /databases/$(database)/documents/residences/$(residenceId)/communityPosts/$(postId)/votes/$(userId)
            )
            && get(
              /databases/$(database)/documents/residences/$(residenceId)/communityPosts/$(postId)
            ).data.kind == 'poll'
            && request.resource.data.keys().hasOnly([
              'userId',
              'optionId',
              'createdAt'
            ])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.optionId is string
            && request.resource.data.optionId.matches('^option-[0-4]$')
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }
      }

      match /buildings/{buildingId} {
        allow read: if isResidenceMember(residenceId);
        allow create: if canManageResidence(residenceId)
          || (
            verifiedPhone()
            && !exists(residencePath(residenceId))
            && getAfter(
              memberPath(residenceId, request.auth.uid)
            ).data.role == 'president'
          );
        allow update, delete: if canManageResidence(residenceId);

        match /floors/{floorId} {
          allow read: if isResidenceMember(residenceId);
          allow create: if canManageResidence(residenceId)
            || (
              verifiedPhone()
              && !exists(residencePath(residenceId))
              && getAfter(
                memberPath(residenceId, request.auth.uid)
              ).data.role == 'president'
            );
          allow update, delete: if canManageResidence(residenceId);

          match /apartments/{apartmentId} {
            allow read: if isResidenceMember(residenceId);
            allow create: if canManageResidence(residenceId)
              && request.resource.data.keys().hasOnly([
                'number',
                'createdAt'
              ])
              && request.resource.data.number is int
              && request.resource.data.number >= 0
              && request.resource.data.createdAt == request.time;
            allow delete: if canManageResidence(residenceId);
          }
        }
      }
    }

    match /residenceCodes/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if verifiedPhone()
        && request.resource.data.keys().hasOnly(['residenceId'])
        && request.resource.data.residenceId is string
        && !exists(residencePath(request.resource.data.residenceId))
        && getAfter(
          memberPath(
            request.resource.data.residenceId,
            request.auth.uid
          )
        ).data.role == 'president'
        && getAfter(
          privateSettingsPath(request.resource.data.residenceId)
        ).data.joinCode == code;
    }

    match /{path=**}/members/{memberId} {
      allow get: if signedIn()
        && memberId == request.auth.uid;
      allow list: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /{path=**}/settings/{settingsId} {
      allow read: if signedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    // A collection-group query can target every collection named
    // "invitations", so it needs this recursive rule in rules version 2.
    match /{path=**}/invitations/{invitationId} {
      allow read: if verifiedPhone()
        && resource.data.phoneNumber == request.auth.token.phone_number;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
