rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(residenceId) {
      return /databases/(default)/documents/residences/$(residenceId)/members/$(request.auth.uid);
    }

    function residenceAcceptsWrites(residenceId) {
      let residence = firestore.get(
        /databases/(default)/documents/residences/$(residenceId)
      ).data;
      return residence != null && residence.get('deletionStartedBy', null) == null;
    }

    function membership(residenceId) {
      return firestore.get(memberPath(residenceId)).data;
    }

    function isResidenceMember(residenceId) {
      return signedIn() && hasActiveMembership(residenceId);
    }

    function hasActiveMembership(residenceId) {
      let member = membership(residenceId);
      return member != null && member.status == 'active';
    }

    function canSupportResidence(residenceId) {
      return signedIn()
        && request.auth.token.get('developer', false) == true
        && firestore.get(/databases/(default)/documents/appPermissions/$(request.auth.uid))
          .data.developer == true
        && firestore.exists(/databases/(default)/documents/residences/$(residenceId));
    }

    function canReadResidence(residenceId) {
      return canSupportResidence(residenceId) || isResidenceMember(residenceId);
    }

    function canManageResidence(residenceId) {
      return (canSupportResidence(residenceId) || isDelegatedManager(residenceId))
        && residenceAcceptsWrites(residenceId);
    }

    function isDelegatedManager(residenceId) {
      let member = membership(residenceId);
      return signedIn()
        && member != null
        && member.status == 'active'
        && (
          member.role in ['president', 'owner']
          || member.hasPresidentPermissions == true
        );
    }

    function canEditResidenceImage(residenceId) {
      return canManageResidence(residenceId)
        || (signedIn() && isCreatorAwaitingPresident(residenceId));
    }

    function isCreatorAwaitingPresident(residenceId) {
      let member = membership(residenceId);
      let residence = firestore.get(
        /databases/(default)/documents/residences/$(residenceId)
      ).data;
      return member != null
        && member.status == 'active'
        && residence != null
        && residence.get('deletionStartedBy', null) == null
        && residence.get('presidentId', '') == null
        && (
          residence.get('createdBy', '') == request.auth.uid
          || (
            !residence.keys().hasAny(['createdBy'])
            && member.get('source', '') == 'residence-creation'
          )
        );
    }

    function isAcceptedDocument() {
      return request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }

    function isAcceptedCommunityImage() {
      return request.resource.size > 0
        && request.resource.size <= 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }

    match /residences/{residenceId}/documents/{documentId}/content {
      allow read: if canReadResidence(residenceId);
      allow create: if canManageResidence(residenceId)
        && isAcceptedDocument()
        && request.resource.metadata.residenceId == residenceId
        && request.resource.metadata.documentId == documentId
        && request.resource.metadata.uploadedBy == request.auth.uid;
      allow update: if false;
      allow delete: if canManageResidence(residenceId);
    }

    match /residences/{residenceId}/attachments/{transactionKey}/content {
      allow read: if canReadResidence(residenceId);
      allow create, update: if canManageResidence(residenceId)
        && isAcceptedDocument()
        && transactionKey.matches('^(finance|dues)-.+$')
        && request.resource.metadata.residenceId == residenceId
        && request.resource.metadata.transactionKey == transactionKey;
      allow delete: if canManageResidence(residenceId);
    }

    match /residences/{residenceId}/community/{postId}/{imageId} {
      allow read: if canReadResidence(residenceId);
      allow create: if isResidenceMember(residenceId)
        && residenceAcceptsWrites(residenceId)
        && isAcceptedCommunityImage()
        && imageId.matches('^image-[0-3]$')
        && request.resource.metadata.residenceId == residenceId
        && request.resource.metadata.postId == postId
        && request.resource.metadata.uploadedBy == request.auth.uid;
      allow update: if false;
      allow delete: if canManageResidence(residenceId)
        || request.auth.uid == resource.metadata.uploadedBy;
    }

    match /residences/{residenceId}/profile/image.jpg {
      allow read: if canReadResidence(residenceId);
      allow create, update: if canEditResidenceImage(residenceId)
        && isAcceptedCommunityImage()
        && request.resource.contentType == 'image/jpeg'
        && request.resource.metadata.residenceId == residenceId
        && request.resource.metadata.uploadedBy == request.auth.uid;
      allow delete: if canEditResidenceImage(residenceId);
    }

    match /users/{userId}/profile/image.jpg {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && isAcceptedCommunityImage()
        && request.resource.contentType == 'image/jpeg'
        && request.resource.metadata.userId == userId
        && request.resource.metadata.uploadedBy == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
